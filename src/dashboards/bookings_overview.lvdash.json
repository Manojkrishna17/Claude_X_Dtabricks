                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "scale": {
                    "type": "quantitative"
                  },
                  "fields": [
                    {
                      "fieldName": "sum(total_revenue)",
                      "displayName": "Revenue ($)",
                      "format": {
                        "type": "number-currency",
                        "currencyCode": "USD",
                        "decimalPlaces": {
                          "type": "max",
                          "places": 0
                        },
                        "abbreviation": "compact"
                      }
                    }
                  ]
                },
                "y": {
                  "fieldName": "city",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "frame": {
                "title": "Top 10 cities by revenue",
                "showTitle": true
