            }
          },
          "position": {
            "x": 0,
            "y": 10,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "top-cities-bookings",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_city_bookings",
